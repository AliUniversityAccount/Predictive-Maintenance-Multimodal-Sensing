import os
import re
import numpy as np
import pandas as pd

image_folder = r"C:\Users\ALI\Downloads\MVS\HikRobot\Unhealthy_MV\50percentunhealthy_mv"
cwt_folder = r"C:\Users\ALI\Downloads\MVS\TENSORS_50_UnhealthyMV"
pnp_file = r"C:\Users\ALI\Downloads\MVS\50percentunhealthyPNP.xlsx"

output_csv = r"C:\Users\ALI\Downloads\MVS\masterdataset_50unhealthyNEW.csv"

df_pnp = pd.read_excel(pnp_file)

df_pnp.columns = [c.strip().lower() for c in df_pnp.columns]

print("PnP columns found:", df_pnp.columns)

required_cols = ["image", "tx", "ty", "tz", "rx", "ry", "rz"]
missing = [c for c in required_cols if c not in df_pnp.columns]

if missing:
    raise ValueError(f"Missing columns in PnP file: {missing}")

pnp_dict = {}

for _, row in df_pnp.iterrows():

    img = row["image"]

    tvec = [row["tx"], row["ty"], row["tz"]]
    rvec = [row["rx"], row["ry"], row["rz"]]

    pnp_dict[img] = (tvec, rvec)

def get_ts(name):
    m = re.search(r'(\d{14})', name)
    if m:
        return m.group(1)
    return None

rows = []

for img in sorted(os.listdir(image_folder)):

    if not img.lower().endswith(".jpg"):
        continue

    cwt_path = os.path.join(
        cwt_folder,
        img.replace(".jpg", ".npy")
    )

    if not os.path.exists(cwt_path):
        continue

    if img not in pnp_dict:
        print("No PnP:", img)
        continue

    tvec, rvec = pnp_dict[img]

    rows.append({
        "image": img,
        "cwt_path": cwt_path,
        "tx": tvec[0],
        "ty": tvec[1],
        "tz": tvec[2],
        "rx": rvec[0],
        "ry": rvec[1],
        "rz": rvec[2],
    })
df = pd.DataFrame(rows)
df.to_csv(output_csv, index=False)

print("MASTER DATASET CREATED")
print("Saved at:", output_csv)
