#Comparing the CNN model to other regression models
import pandas as pd
import numpy as np
import torch
import torch.nn as nn
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

from sklearn.linear_model import LinearRegression
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor

df = pd.read_csv(r"C:\Users\ALI\Downloads\MVS\data_processed\final\MASTER_30_PI_FINAL.csv")

df["rul"] = 1 - df["label"]

train_df, test_df = train_test_split(
    df, test_size=0.3, random_state=42, stratify=df["label"]
)

X_train = train_df[["tx","ty","tz","rx","ry","rz"]]
y_train = train_df["rul"]

X_test = test_df[["tx","ty","tz","rx","ry","rz"]]
y_test = test_df["rul"]

def evaluate(name, y_true, y_pred):
    mae = mean_absolute_error(y_true, y_pred)
    rmse = np.sqrt(mean_squared_error(y_true, y_pred))
    r2 = r2_score(y_true, y_pred)

    return {"Model": name, "MAE": mae, "RMSE": rmse, "R2": r2}

results = []

# 1. LINEAR REGRESSION
lr = LinearRegression()
lr.fit(X_train, y_train)
lr_pred = lr.predict(X_test)

results.append(evaluate("Linear Regression", y_test, lr_pred))

# 2. RANDOM FOREST
rf = RandomForestRegressor(n_estimators=100, max_depth=5, random_state=42)
rf.fit(X_train, y_train)
rf_pred = rf.predict(X_test)

results.append(evaluate("Random Forest", y_test, rf_pred))

# 3. GRADIENT BOOSTING
gb = GradientBoostingRegressor(n_estimators=100, learning_rate=0.1)
gb.fit(X_train, y_train)
gb_pred = gb.predict(X_test)

results.append(evaluate("Gradient Boosting", y_test, gb_pred))

# 4. CNN MODEL
class FusionNet(nn.Module):
    def __init__(self):
        super().__init__()

        self.cnn = nn.Sequential(
            nn.Conv2d(6,16,3,padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2),

            nn.Conv2d(16,32,3,padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2),

            nn.Flatten()
        )

        dummy = torch.zeros(1,6,128,128)
        cnn_out = self.cnn(dummy).shape[1]

        self.pnp = nn.Sequential(
            nn.Linear(6,32),
            nn.ReLU(),
            nn.Linear(32,16)
        )

        self.fc = nn.Sequential(
            nn.Linear(cnn_out + 16,64),
            nn.ReLU(),
            nn.Linear(64,1)
        )

    def forward(self, cwt, pnp):
        return self.fc(torch.cat([self.cnn(cwt), self.pnp(pnp)], dim=1))


model = FusionNet()
model.load_state_dict(torch.load("fusion_model_best.pth"))
model.eval()

cnn_preds = []

for _, row in test_df.iterrows():
    cwt = np.load(row["cwt_path"])
    cwt = torch.tensor(cwt, dtype=torch.float32).unsqueeze(0)

    pnp = torch.tensor([
        row["tx"],row["ty"],row["tz"],
        row["rx"],row["ry"],row["rz"]
    ], dtype=torch.float32).unsqueeze(0)

    with torch.no_grad():
        score = torch.sigmoid(model(cwt, pnp)).item()

    cnn_preds.append(1 - score)

cnn_preds = np.array(cnn_preds)

results.append(evaluate("CNN Fusion", y_test, cnn_preds))

results_df = pd.DataFrame(results)

print("\n===== MODEL COMPARISON =====")
print(results_df)

plt.figure(figsize=(10,4))

plt.subplot(1,2,1)
plt.bar(results_df["Model"], results_df["MAE"])
plt.xticks(rotation=20)
plt.title("MAE Comparison")

plt.subplot(1,2,2)
plt.bar(results_df["Model"], results_df["RMSE"])
plt.xticks(rotation=20)
plt.title("RMSE Comparison")

plt.tight_layout()
plt.show()
